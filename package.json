    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^6.2.1",
    "graphql": "^16.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tsx": "^4.19.2",
    "prisma": "^6.2.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
